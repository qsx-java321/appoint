MYSQL_USER=appoint_dev
MYSQL_PASSWORD=replace-with-local-secret
RABBITMQ_USER=appoint_dev
RABBITMQ_PASSWORD=replace-with-local-secret
JWT_SECRET=replace-with-at-least-48-random-characters-for-dev
MOCK_PAY_SIGNING_KEY=replace-with-at-least-48-random-characters-for-dev
LOCAL_SEED_PASSWORD=replace-with-local-demo-password
