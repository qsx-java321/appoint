# Docker Compose 本地依赖初始化配置；已有数据卷不会自动应用账号密码变更。
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=appoint
MYSQL_USER=appoint
MYSQL_PASSWORD=appoint@123
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin@123
# 仅用于本地 SeaweedFS S3；未设置时 compose 使用同名默认值。
SEAWEEDFS_ACCESS_KEY=appoint
SEAWEEDFS_SECRET_KEY=appoint-local
