# Spring Boot 本地开发配置；连接凭据须与 compose.env 一致。
DB_URL=jdbc:mysql://localhost:3306/appoint?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=appoint
MYSQL_PASSWORD=appoint@123
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=admin
spring.rabbitmq.password=admin@123
JWT_SECRET=change-this-to-a-long-local-development-secret-key-1234567890
spring.profiles.active=dev

# 本地目录缓存；不同数据库使用不同 namespace。
REDIS_HOST=localhost
REDIS_PORT=6379
appoint.catalog-cache.enabled=true
CATALOG_CACHE_NAMESPACE=local-dev
