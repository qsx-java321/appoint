{
  "name": "hospital-appointment-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:test": "vite --host 127.0.0.1 --mode test",
    "dev:demo": "vite --host 127.0.0.1 --mode demo"
  },
  "dependencies": {
    "axios": "1.21.1",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
